# Managed by Ansible - readable only by the slurm user (contains the DB password)
AuthType=auth/munge
DbdHost={{ inventory_hostname }}
DbdPort=6819
SlurmUser=slurm
DebugLevel=verbose
LogFile=/var/log/slurm/slurmdbd.log
PidFile=/var/run/slurm/slurmdbd.pid

# Database connection
StorageType=accounting_storage/mysql
StorageHost=localhost
StorageLoc={{ slurmdbd_db_name }}
StorageUser={{ slurmdbd_db_user }}
StoragePass={{ slurmdbd_db_password }}
